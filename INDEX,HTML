<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Website NEPER ONE</title>
    <style>
        body {
            background-color: #0f172a; /* Latar belakang gelap modern */
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Tulisan nama NEPER ONE sebagai Watermark Background */
        .bg-name {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-15deg);
            font-size: 12vw; /* Ukuran disesuaikan agar teks yang lebih panjang pas di layar */
            font-weight: 900;
            color: rgba(255, 255, 255, 0.04); /* Transparan/samar */
            letter-spacing: 10px;
            user-select: none;
            z-index: 0;
            white-space: nowrap;
        }

        /* Konten utama */
        .card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(10px);
            padding: 40px;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
            text-align: center;
            z-index: 1;
            max-width: 400px;
        }

        h1 {
            margin-top: 0;
            font-size: 24px;
            color: #38bdf8;
        }

        p {
            color: #94a3b8;
            line-height: 1.6;
        }

        .author-tag {
            display: inline-block;
            margin-top: 15px;
            padding: 6px 16px;
            background-color: #0284c7;
            color: white;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }
    </style>
</head>
<body>

    <!-- Watermark Background -->
    <div class="bg-name">NEPER ONE</div>

    <!-- Konten Depan -->
    <div class="card">
        <h1>Selamat Datang</h1>
        <p>Halaman ini menggunakan desain latar belakang khusus dengan identitas pembuat.</p>
        <div class="author-tag">Dibuat oleh: NEPER ONE</div>
    </div>

</body>
</html>
